rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == role
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.active == true;
    }
    function isAdmin() { return hasRole('admin'); }
    function isEmployee() { return hasRole('employee'); }
    function isDealer() { return hasRole('dealer'); }

    // Main KM data: employees can view shared product/outlet information;
    // only Admin can change billing, products, outlets, settings and reports.
    match /appData/{documentId} {
      allow read: if isAdmin() || (documentId == 'shared' && isDealer());
      allow write: if isAdmin();
    }

    // Employee data is isolated by authenticated employee UID.
    match /employeeData/{uid} {
      allow read: if isAdmin() || (isEmployee() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Each employee maintains their own area and exactly six route names.
    match /employeeProfiles/{uid} {
      allow read: if isAdmin() || (isEmployee() && request.auth.uid == uid);
      allow create, update: if isEmployee()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.name == get(/databases/$(database)/documents/userRoles/$(uid)).data.name
        && request.resource.data.employeeId == get(/databases/$(database)/documents/userRoles/$(uid)).data.employeeId
        && request.resource.data.areaName is string
        && request.resource.data.areaName.size() > 0
        && request.resource.data.routes is list
        && request.resource.data.routes.size() == 6;
      allow delete: if isAdmin();
    }

    match /dealerData/{uid} {
      allow read: if isAdmin() || (isDealer() && request.auth.uid == uid);
      allow write: if isDealer() && request.auth.uid == uid;
    }

    // Employees may submit new shop records for Admin approval only.
    match /employeeOutletRequests/{requestId} {
      allow create: if isEmployee()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.enteredBy == get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.name
        && request.resource.data.areaName == get(/databases/$(database)/documents/employeeProfiles/$(request.auth.uid)).data.areaName
        && request.resource.data.route in get(/databases/$(database)/documents/employeeProfiles/$(request.auth.uid)).data.routes
        && request.resource.data.status == 'Pending Admin Approval';
      allow read: if isAdmin()
        || (isEmployee() && resource.data.createdBy == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isAdmin() || (isEmployee()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'Pending Admin Review'
        && request.resource.data.employee is string
        && request.resource.data.outletId is number
        && request.resource.data.outletName is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.employee == get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.name
        && request.resource.data.employeeId == get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.employeeId
        && request.resource.data.areaName == get(/databases/$(database)/documents/employeeProfiles/$(request.auth.uid)).data.areaName
        && request.resource.data.route in get(/databases/$(database)/documents/employeeProfiles/$(request.auth.uid)).data.routes);
      allow read: if isAdmin()
        || (isEmployee() && resource.data.createdBy == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Delivery status is changed only by Admin; employee confirmation is disabled.
    match /deliveryConfirmations/{confirmationId} {
      allow read, write: if isAdmin();
    }

    // Role documents are provisioned by the project owner in Firebase Console.
    // Clients cannot grant themselves Admin or Employee privileges.
    match /userRoles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Admin may provision and manage Employee accounts, but cannot grant Admin roles.
      allow create, update: if isAdmin()
        && request.resource.data.role == 'employee'
        && request.resource.data.active is bool
        && request.resource.data.name is string
        && request.resource.data.route != null;
      allow delete: if isAdmin() && resource.data.role == 'employee';
    }

    // Deny all unspecified collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}